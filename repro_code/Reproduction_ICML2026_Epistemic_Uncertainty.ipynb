    "\n",
    "fig, axes = plt.subplots(1, 3, figsize=(15, 5))\n",
    "axes[0].plot(n_vals, tr_list, 'o-', color='steelblue')\n",
    "axes[0].set(xlabel='n', ylabel='tr(Cov)/d', title='Claim 4: Parameter Uncertainty', xscale='log', yscale='log'); axes[0].grid(alpha=0.3)\n",
