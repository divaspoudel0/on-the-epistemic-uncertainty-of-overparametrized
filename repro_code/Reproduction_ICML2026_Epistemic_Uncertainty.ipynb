   "source": [
    "import torch\n",
    "import torch.nn as nn\n",
    "import numpy as np\n",
    "from scipy import stats\n",
    "from scipy.special import gamma as gamma_fn\n",
    "import matplotlib.pyplot as plt\n",
    "import json\n",
    "from pathlib import Path\n",
    "from collections import Counter\n",
    "import warnings\n",
    "warnings.filterwarnings('ignore')\n",
    "\n",
    "torch.set_default_dtype(torch.float64)\n",
    "torch.manual_seed(42)\n",
    "np.random.seed(42)\n",
    "\n",
    "RESULTS_DIR = Path('results')\n",
    "RESULTS_DIR.mkdir(exist_ok=True)\n",
    "print(f'Device: {\"cuda\" if torch.cuda.is_available() else \"cpu\"}')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ============================================================\n",
    "# MODEL & DATA UTILITIES\n",
    "# ============================================================\n",
    "class ReLUNetwork(nn.Module):\n",
    "    def __init__(self, p, M):\n",
    "        super().__init__()\n",
    "        self.p, self.M = p, M\n",
    "        self.W1 = nn.Parameter(torch.randn(M, p) * 0.5)\n",
    "        self.w2 = nn.Parameter(torch.randn(M) * 0.5)\n",
    "    def forward(self, x):\n",
    "        return torch.relu(x @ self.W1.T) @ self.w2\n",
    "    def get_weights_flat(self):\n",
    "        return torch.cat([self.W1.flatten(), self.w2])\n",
    "\n",
    "def generate_true_network(p=5, M_star=5, seed=0):\n",
    "    rng = np.random.RandomState(seed)\n",
    "    W1 = rng.randn(M_star, p)\n",
    "    for i in range(1, M_star):\n",
    "        for j in range(i):\n",
    "            proj = np.dot(W1[i], W1[j]) / (np.dot(W1[j], W1[j]) + 1e-10)\n",
    "            W1[i] -= proj * W1[j]\n",
    "    W1 = W1 / np.linalg.norm(W1, axis=1, keepdims=True)\n",
    "    w2 = np.array([(-1)**i * (1.0 + 0.5*i) for i in range(M_star)])\n",
    "    for m in range(M_star):\n",
    "        W1[m] *= np.abs(w2[m])\n",
    "    return W1, w2\n",
    "\n",
    "def generate_data(W1_star, w2_star, n, sigma=1.0, seed=0):\n",
    "    rng = np.random.RandomState(seed)\n",
    "    p = W1_star.shape[1]\n",
    "    X = rng.randn(n, p)\n",
    "    y = np.maximum(X @ W1_star.T, 0) @ w2_star + sigma * rng.randn(n)\n",
    "    return X, y\n",
    "\n",
    "print('Model and data utilities loaded.')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ============================================================\n",
    "# HMC SAMPLER\n",
    "# ============================================================\n",
    "def hmc_log_prob(w, X, y, sigma_noise=1.0, lambda_prior=1.0):\n",
    "    M = len(w) // (X.shape[1] + 1)\n",
    "    p = X.shape[1]\n",
    "    W1 = w[:M*p].reshape(M, p)\n",
    "    w2 = w[M*p:]\n",
    "    f = torch.relu(X @ W1.T) @ w2\n",
    "    ll = -0.5 * torch.sum((y - f)**2) / sigma_noise**2\n",
    "    lp = -lambda_prior * torch.sum(w**2)\n",
    "    return ll + lp\n",
    "\n",
    "def hmc_leapfrog(w, grad_fn, step_size, n_steps):\n",
    "    w = w.clone().detach().requires_grad_(True)\n",
    "    p_mom = torch.randn_like(w)\n",
    "    w_new, p_new = w.clone(), p_mom.clone()\n",
    "    grad = grad_fn(w_new)\n",
    "    p_new = p_new + 0.5 * step_size * grad\n",
    "    for _ in range(n_steps - 1):\n",
    "        w_new = (w_new + step_size * p_new).detach().requires_grad_(True)\n",
    "        p_new = p_new + step_size * grad_fn(w_new)\n",
    "    w_new = (w_new + step_size * p_new).detach().requires_grad_(True)\n",
    "    grad = grad_fn(w_new)\n",
    "    p_new = p_new + 0.5 * step_size * grad\n",
    "    return w_new.detach(), p_new\n",
    "\n",
    "def run_hmc(X, y, M, n_samples=500, n_warmup=200, step_size=5e-4,\n",
    "            n_leapfrog=10, thin=5, sigma_noise=1.0, n_chains=3, seed=0):\n",
    "    p = X.shape[1]\n",
    "    d = M * (p + 1)\n",
    "    X_t, y_t = torch.tensor(X), torch.tensor(y)\n",
    "    def grad_fn(w):\n",
    "        w.requires_grad_(True)\n",
    "        return torch.autograd.grad(hmc_log_prob(w, X_t, y_t, sigma_noise), w)[0]\n",
    "    all_samples = []\n",
    "    for chain in range(n_chains):\n",
    "        torch.manual_seed(seed + chain * 1000)\n",
    "        w = torch.randn(d) * 0.1\n",
    "        w.requires_grad_(True)\n",
    "        # Warmup\n",
    "        for i in range(n_warmup):\n",
    "            w_new, p_new = hmc_leapfrog(w, grad_fn, step_size, n_leapfrog)\n",
    "            lp_old = hmc_log_prob(w, X_t, y_t, sigma_noise)\n",
    "            lp_new = hmc_log_prob(w_new, X_t, y_t, sigma_noise)\n",
    "            if np.log(np.random.rand()) < (lp_new - lp_old).item():\n",
    "                w = w_new.detach()\n",
    "            if i % 50 == 0 and i > 0:\n",
    "                ar = min(1.0, np.exp((lp_new - lp_old).item()))\n",
    "                step_size *= 1.2 if ar > 0.8 else (0.8 if ar < 0.2 else 1.0)\n",
    "                step_size = np.clip(step_size, 1e-6, 0.1)\n",
    "        # Sample\n",
    "        samples = []\n",
    "        for i in range(n_samples * thin):\n",
    "            w_new, p_new = hmc_leapfrog(w, grad_fn, step_size, n_leapfrog)\n",
    "            lp_old = hmc_log_prob(w, X_t, y_t, sigma_noise)\n",
    "            lp_new = hmc_log_prob(w_new, X_t, y_t, sigma_noise)\n",
    "            if np.log(np.random.rand()) < (lp_new - lp_old).item():\n",
    "                w = w_new.detach()\n",
    "            if i % thin == 0:\n",
    "                samples.append(w.clone().numpy())\n",
    "        all_samples.append(np.array(samples))\n",
    "        print(f'  Chain {chain+1}: {len(samples)} samples, step={step_size:.2e}')\n",
    "    return all_samples\n",
    "\n",
    "print('HMC sampler loaded.')"
   ]
  },
  {
   "cell_type": "markdown",
