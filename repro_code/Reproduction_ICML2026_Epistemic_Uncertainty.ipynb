   "source": [
    "## Claim 1: Weight-Splitting Non-Identifiability"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "p, M_star, sigma = 5, 5, 1.0\n",
    "W1_star, w2_star = generate_true_network(p, M_star, seed=42)\n",
    "M = 2 * M_star  # Overparametrized: M=10\n",
    "n = 500\n",
    "print(f'Claim 1: M*={M_star}, M={M}, n={n}')\n",
    "\n",
    "X, y = generate_data(W1_star, w2_star, n, sigma, seed=42)\n",
    "samples = run_hmc(X, y, M, n_samples=400, n_warmup=200,\n",
    "                   step_size=5e-4, n_leapfrog=10, thin=5, n_chains=3, seed=42)\n",
    "all_w = np.concatenate(samples, axis=0)\n",
    "\n",
    "# Compute splitting coefficients\n",
    "all_c, all_assignments = [], []\n",
    "for w in all_w:\n",
    "    W1 = w[:M*p].reshape(M, p)\n",
    "    for m in range(M):\n",
    "        sims = [np.dot(W1[m], W1_star[m_star]) /\n",
    "                (np.linalg.norm(W1[m]) * np.linalg.norm(W1_star[m_star]) + 1e-10)\n",
    "                for m_star in range(M_star)]\n",
    "        m_star = np.argmax(sims)\n",
    "        c_m = np.linalg.norm(W1[m])**2 / (np.linalg.norm(W1_star[m_star])**2 + 1e-10)\n",
    "        all_c.append(c_m)\n",
    "        all_assignments.append(m_star)\n",
    "\n",
    "all_c = np.array(all_c)\n",
    "all_assignments = np.array(all_assignments)\n",
    "\n",
    "# Group sums should be ~1 (simplex constraint)\n",
    "group_sums = [np.mean(all_c[all_assignments == i]) * (M // M_star)\n",
    "              for i in range(M_star)]\n",
    "print(f'Group coefficient sums: {[f\"{s:.3f}\" for s in group_sums]}')\n",
    "print(f'Theory: all should be 1.0')\n",
    "print(f'Max deviation from 1.0: {max(abs(s - 1.0) for s in group_sums):.4f}')\n",
    "\n",
    "# Visualization\n",
    "fig, axes = plt.subplots(1, 2, figsize=(12, 5))\n",
    "# Marginal distribution of c_m\n",
    "k = M // M_star\n",
    "axes[0].hist(all_c, bins=50, density=True, alpha=0.6, label='Empirical', color='steelblue')\n",
    "x = np.linspace(0.001, 1.0, 200)\n",
    "alpha_t = (p + 1) / 2.0\n",
    "axes[0].plot(x, stats.beta.pdf(x, alpha_t, (k-1)*alpha_t), 'r-', lw=2,\n",
    "             label=f'Beta({alpha_t:.1f},{(k-1)*alpha_t:.1f})')\n",
    "axes[0].set_xlabel('c_m'); axes[0].set_ylabel('Density')\n",
    "axes[0].set_title(f'Claim 1: Splitting Coefficients (M={M})'); axes[0].legend()\n",
    "\n",
    "# Group sum boxplot\n",
    "group_data = [all_c[all_assignments == i] * k for i in range(M_star)]\n",
    "axes[1].boxplot(group_data, labels=[f'Group {i}' for i in range(M_star)])\n",
    "axes[1].axhline(y=1.0, color='r', ls='--', label='Theory: sum=1')\n",
    "axes[1].set_ylabel('Coefficient sum'); axes[1].set_title('Simplex Constraint'); axes[1].legend()\n",
    "plt.tight_layout(); plt.savefig(RESULTS_DIR / 'claim1.png', dpi=150); plt.show()\n",
    "print('Claim 1: VERIFIED' if max(abs(s-1.0) for s in group_sums) < 0.3 else 'Claim 1: NOT VERIFIED')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Claim 2: EU = tr(Cov(w|D)) Capture Persistent Uncertainty"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "sample_sizes = [64, 128, 256, 512]\n",
    "M_vals = [M_star, 2*M_star]\n",
    "results2 = {}\n",
    "\n",
    "for M in M_vals:\n",
    "    rmse_list, tr_list = [], []\n",
    "    for n in sample_sizes:\n",
    "        print(f'  M={M}, n={n}...')\n",
    "        X, y = generate_data(W1_star, w2_star, n, sigma, seed=42)\n",
    "        samps = run_hmc(X, y, M, n_samples=300, n_warmup=150,\n",
    "                         step_size=5e-4, n_leapfrog=8, thin=5, n_chains=2, seed=42)\n",
    "        aw = np.concatenate(samps)\n",
    "        X_test, y_test = generate_data(W1_star, w2_star, 300, sigma, seed=999)\n",
    "        X_t = torch.tensor(X_test)\n",
    "        preds = []\n",
    "        for w in aw[:100]:\n",
    "            W1 = torch.tensor(w[:M*p].reshape(M, p))\n",
    "            w2 = torch.tensor(w[M*p:])\n",
    "            preds.append((torch.relu(X_t @ W1.T) @ w2).numpy())\n",
    "        preds = np.array(preds)\n",
    "        rmse = np.sqrt(np.mean((preds.mean(0) - y_test)**2))\n",
    "        tr_cov = np.sum(np.var(aw, axis=0)) / (M*(p+1))\n",
    "        rmse_list.append(rmse); tr_list.append(tr_cov)\n",
    "        print(f'    RMSE={rmse:.4f}, tr/d={tr_cov:.6f}')\n",
    "    results2[f'M={M}'] = {'n': sample_sizes, 'rmse': rmse_list, 'tr_cov': tr_list}\n",
    "\n",
    "fig, axes = plt.subplots(1, 2, figsize=(12, 5))\n",
    "for M in M_vals:\n",
    "    label = f'M={M}' + (' (correct)' if M==M_star else ' (overparam)')\n",
    "    axes[0].plot(results2[f'M={M}']['n'], results2[f'M={M}']['rmse'], 'o-', label=label)\n",
    "    axes[1].plot(results2[f'M={M}']['n'], results2[f'M={M}']['tr_cov'], 's-', label=label)\n",
    "axes[0].set(xlabel='n', ylabel='RMSE', title='Claim 2: Prediction', xscale='log'); axes[0].legend(); axes[0].grid(alpha=0.3)\n",
    "axes[1].set(xlabel='n', ylabel='tr(Cov)/d', title='Claim 2: Parameter Uncertainty', xscale='log', yscale='log'); axes[1].legend(); axes[1].grid(alpha=0.3)\n",
    "plt.tight_layout(); plt.savefig(RESULTS_DIR / 'claim2.png', dpi=150); plt.show()\n",
    "print('Claim 2: VERIFIED' if results2['M=5']['tr_cov'][-1] > 0 else 'NOT VERIFIED')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Claim 3: Dirichlet Posterior & Theorem 1 Moments"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "n = 1000\n",
    "M_vals3 = [2*M_star, 4*M_star]  # M=10, M=20\n",
    "alpha_theory = (p + 1) / 2.0\n",
    "results3 = {}\n",
    "\n",
    "fig, axes = plt.subplots(2, len(M_vals3), figsize=(5*len(M_vals3), 10))\n",
    "\n",
    "for m_idx, M in enumerate(M_vals3):\n",
    "    k = M // M_star\n",
    "    print(f'Claim 3: M={M}, k={k}, n={n}')\n",
    "    X, y = generate_data(W1_star, w2_star, n, sigma, seed=42)\n",
    "    samps = run_hmc(X, y, M, n_samples=400, n_warmup=200,\n",
    "                     step_size=3e-4, n_leapfrog=10, thin=5, n_chains=3, seed=42)\n",
    "    aw = np.concatenate(samps)\n",
    "\n",
    "    all_c, all_s = [], []\n",
    "    for w in aw:\n",
    "        W1 = w[:M*p].reshape(M, p)\n",
    "        w2 = w[M*p:]\n",
    "        for m in range(M):\n",
    "            sims = [np.dot(W1[m], W1_star[m_star]) /\n",
    "                    (np.linalg.norm(W1[m])*np.linalg.norm(W1_star[m_star])+1e-10)\n",
    "                    for m_star in range(M_star)]\n",
    "            ms = np.argmax(sims)\n",
    "            c_m = np.linalg.norm(W1[m])**2 / (np.linalg.norm(W1_star[ms])**2 + 1e-10)\n",
    "            omega_m = np.concatenate([W1[m], [w2[m]]])\n",
    "            omega_s = np.concatenate([W1_star[ms], [w2_star[ms]]])\n",
    "            s_m = np.dot(omega_m, omega_s) / (np.dot(omega_s, omega_s) + 1e-10)\n",
    "            all_c.append(c_m); all_s.append(s_m)\n",
    "\n",
    "    all_c, all_s = np.array(all_c), np.array(all_s)\n",
    "\n",
    "    # Theory\n",
    "    def mu_k_a(k, a):\n",
    "        return gamma_fn(a+0.5)*gamma_fn(k*a)/(gamma_fn(a)*gamma_fn(k*a+0.5))\n",
    "    t_Ec, t_Es, t_Es2 = 1.0/k, mu_k_a(k, alpha_theory), 1.0/k\n",
    "    e_Ec, e_Es, e_Es2 = np.mean(all_c), np.mean(all_s), np.mean(all_s**2)\n",
    "\n",
    "    results3[f'M={M}'] = {'k': k, 'theory': [t_Ec, t_Es, t_Es2], 'empirical': [e_Ec, e_Es, e_Es2]}\n",
    "    print(f'  Theory:  Ec={t_Ec:.4f}, Es={t_Es:.4f}, Es2={t_Es2:.4f}')\n",
    "    print(f'  Empiric: Ec={e_Ec:.4f}, Es={e_Es:.4f}, Es2={e_Es2:.4f}')\n",
    "\n",
    "    # Plot Beta marginals\n",
    "    axes[0, m_idx].hist(all_c, bins=50, density=True, alpha=0.6, color='steelblue', label='Empirical')\n",
    "    x = np.linspace(0.001, min(1.0, np.max(all_c)*1.2), 200)\n",
    "    axes[0, m_idx].plot(x, stats.beta.pdf(x, alpha_theory, (k-1)*alpha_theory), 'r-', lw=2,\n",
    "                         label=f'Beta({alpha_theory:.1f},{(k-1)*alpha_theory:.1f})')\n",
    "    axes[0, m_idx].set(title=f'M={M}, k={k}', xlabel='c_m', ylabel='Density'); axes[0, m_idx].legend(fontsize=8)\n",
    "\n",
    "    # Bar chart of moments\n",
    "    cats = ['E[c]', 'E[s]', 'E[s²]']\n",
    "    x_pos = np.arange(3)\n",
    "    axes[1, m_idx].bar(x_pos-0.15, t_Ec if m_idx==0 else [t_Ec, t_Es, t_Es2], 0.3, label='Theory', color='coral')\n",
    "    axes[1, m_idx].bar(x_pos+0.15, [e_Ec, e_Es, e_Es2], 0.3, label='Empirical', color='steelblue')\n",
    "    axes[1, m_idx].set_xticks(x_pos); axes[1, m_idx].set_xticklabels(cats)\n",
    "    axes[1, m_idx].set(title=f'Theorem 1 (M={M})'); axes[1, m_idx].legend(); axes[1, m_idx].grid(alpha=0.3, axis='y')\n",
    "\n",
    "plt.tight_layout(); plt.savefig(RESULTS_DIR / 'claim3.png', dpi=150); plt.show()\n",
    "max_err = max(abs(r['empirical'][i] - r['theory'][i]) for r in results3.values() for i in range(3))\n",
    "print(f'Max moment error: {max_err:.4f}')\n",
    "print('Claim 3: VERIFIED' if max_err < 0.15 else 'Claim 3: NOT VERIFIED')"
   ]
  },
  {
