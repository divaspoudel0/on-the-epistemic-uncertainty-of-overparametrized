   "source": [
    "## Claim 4: Non-Degenerate Posterior as n → ∞"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "M = 2 * M_star\n",
    "n_vals = [128, 256, 512, 1024]\n",
    "tr_list, var_c_list, rmse_list = [], [], []\n",
    "\n",
    "for n in n_vals:\n",
    "    print(f'Claim 4: n={n}...')\n",
    "    X, y = generate_data(W1_star, w2_star, n, sigma, seed=42)\n",
    "    samps = run_hmc(X, y, M, n_samples=300, n_warmup=150,\n",
    "                     step_size=3e-4, n_leapfrog=10, thin=5, n_chains=2, seed=42)\n",
    "    aw = np.concatenate(samps)\n",
    "    tr_cov = np.sum(np.var(aw, axis=0)) / (M*(p+1))\n",
    "\n",
    "    all_c = []\n",
    "    for w in aw:\n",
    "        W1 = w[:M*p].reshape(M, p)\n",
    "        for m in range(M):\n",
    "            sims = [np.dot(W1[m], W1_star[ms])/(np.linalg.norm(W1[m])*np.linalg.norm(W1_star[ms])+1e-10)\n",
    "                    for ms in range(M_star)]\n",
    "            ms = np.argmax(sims)\n",
    "            all_c.append(np.linalg.norm(W1[m])**2 / (np.linalg.norm(W1_star[ms])**2 + 1e-10))\n",
    "\n",
    "    X_test, y_test = generate_data(W1_star, w2_star, 300, sigma, seed=999)\n",
    "    X_t = torch.tensor(X_test)\n",
    "    preds = [(torch.relu(X_t @ torch.tensor(w[:M*p].reshape(M,p))) @ torch.tensor(w[M*p:])).numpy()\n",
    "             for w in aw[:100]]\n",
    "    rmse = np.sqrt(np.mean((np.mean(preds, axis=0) - y_test)**2))\n",
    "\n",
